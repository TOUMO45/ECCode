{
  "layer": "debugging",
  "trust": "internal",
  "content": {
    "title": "<symptom → cause, short>",
    "problem": "<what went wrong and its impact>",
    "symptoms": ["<exact error text or behavior>"],
    "component": "<module/service>",
    "environment": { "node": ">=20" },
    "fingerprint": "<stable-signature>",
    "occurredAt": "<ISO time first observed>",
    "reproduction": { "steps": ["<step>"], "evidence": ["ev:<failing check, purpose=reproduction>"] },
    "rootCause": { "explanation": "<mechanism, not a guess>", "evidence": ["ev:<id>", "artifact:<path>"] },
    "failedAttempts": [{ "approach": "<what was tried>", "whyFailed": "<why it did not work>" }],
    "solution": { "description": "<the fix>", "tradeoffs": "<costs/limits of the fix>" },
    "verification": { "evidence": ["ev:<same command, now passing>"], "regressionTest": "<command>" },
    "sources": [{ "title": "<doc/release note/issue>", "url": "<url>", "checkedAt": "YYYY-MM-DD" }],
    "appliesWhen": ["<conditions where the lesson holds>"],
    "notApplicableWhen": ["env:node <18", "<other exclusions>"],
    "confidence": "medium",
    "tags": []
  }
}
