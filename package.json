{
  "name": "eccode",
  "version": "0.1.0",
  "description": "Evidence-gated multi-agent engineering toolkit for Claude Code: review gates enforced in code, resumable delivery state, and a reviewed engineering memory.",
  "license": "MIT",
  "type": "commonjs",
  "bin": {
    "eccode": "bin/eccode.js"
  },
  "main": "lib/index.js",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "validate": "node scripts/validate-toolkit.js",
    "check": "node scripts/validate-toolkit.js && node --test tests/*.test.js"
  },
  "files": [
    "bin/",
    "lib/",
    "schemas/",
    "agents/",
    "skills/",
    "commands/",
    "hooks/",
    "scripts/",
    "templates/",
    ".claude-plugin/",
    "docs/",
    "NOTICE",
    "LICENSE"
  ],
  "keywords": [
    "claude-code",
    "agents",
    "multi-agent",
    "review-gates",
    "orchestration",
    "engineering-memory"
  ]
}
