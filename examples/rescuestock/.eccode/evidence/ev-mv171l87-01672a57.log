RS-11 (maxPickups=1)            : {"A":{"codes":["INSUFFICIENT_QTY","TOO_MANY_PICKUPS"],"cheapestCovering":"A+B 8400 cents, 2 pickups"},"B":{"codes":["INSUFFICIENT_QTY","TOO_MANY_PICKUPS"],"cheapestCovering":"A+B 8400 cents, 2 pickups"},"E":{"codes":["INSUFFICIENT_QTY","TOO_MANY_PICKUPS"],"cheapestCovering":"A+E 9500 cents, 2 pickups"}}
