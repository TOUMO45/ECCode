$ node -e '
const fs=require("node:fs");const b=fs.readFileSync(".eccode/artifacts/architecture/brief.md","utf8");const g=fs.readFileSync("docs/build/goal.md","utf8");
const cnt=(t,re)=>(t.match(re)||[]).length;
const terms={"refunding":/\brefunding\b/g,"failed_needs_attention":/failed_needs_attention/g,"cancelling (aggregate state)":/\bcancelling\b/g,"authorization/capture PENDING state":/(authorization|capture)_?pending|PENDING/g,"on_hand":/on_hand/g,"Sandbox transactions labelled":/Sandbox transactions/g,"test prices":/test prices/gi,"test:browser / browser script":/test:browser|npm run test:b/g,"executing / claim":/executing|exclusive claim/g,"busy_timeout":/busy_timeout|busy timeout/gi,"experimental-sqlite":/experimental-sqlite/g,"SameSite":/SameSite/gi,"rate limit":/rate.limit/gi,"derivation table":/derivation|derived from/gi,"void":/void/gi,"plan.md adopted unchanged":/adopted unchanged/g};
for(const [k,re] of Object.entries(terms))console.log(("brief:"+k).padEnd(48),cnt(b,re),"| goal:",cnt(g,re));
const line=(t,id)=>t.split("\n").find(l=>l.includes(id));
console.log("\nGOAL  RS-31:",line(g,"**RS-31**"));console.log("BRIEF RS-31:",line(b,"- RS-31:"));
console.log("GOAL  labelling:",line(g,"All demonstration data"));console.log("BRIEF RS-34:",line(b,"- RS-34:"));
console.log("table rows for suppliers A-E in brief:",cnt(b,/^\| [A-E] \|/gm),"; in goal:",cnt(g,/^\| [A-E] \|/gm));
console.log("BRIEF arch line:",line(b,"adopted unchanged").slice(0,260));
console.log("BRIEF NFR3:",line(b,"- NFR3"));
'
