# RescueStock environment template. Copy to .env (which .gitignore covers) and edit.
#
# Rules for this file:
#   - Every variable the application reads is listed here by name.
#   - Active lines carry only non-secret defaults. A copy of this file starts
#     the application with its defaults and nothing else.
#   - Secrets are shown as <placeholder> and are commented out. The
#     configuration loader refuses a placeholder-shaped secret value (anything
#     in angle brackets, "changeme" or "password"), also for secrets the
#     current mode does not use, and names the variable. So uncomment a
#     secret line only after replacing the placeholder with a real value.
#   - Keep real values out of this file. Put them in .env or in the
#     environment of the process.
#
# The application does not read .env itself. Load it with the shell
# (set -a; . ./.env; set +a) or with node --env-file=.env; see README.md.

# --- Server -----------------------------------------------------------------
PORT=3000
HOST=127.0.0.1
# Public origin, used for return and cancel URLs, the Origin check and the
# Secure flag of the session cookie. Unset: http://localhost:<PORT>. Behind an
# HTTPS reverse proxy set it to the https origin and set RS_TRUST_PROXY=1.
# RS_PUBLIC_URL=http://localhost:3000
# Extra Host header values to accept (comma separated). Empty: none.
RS_ALLOWED_HOSTS=
RS_TRUST_PROXY=0

# --- Storage ----------------------------------------------------------------
RS_DB_PATH=data/app.db
RS_UPLOAD_DIR=data/uploads
# 0 to 5000
RS_DB_BUSY_TIMEOUT_MS=5000

# --- Demo data and timing ---------------------------------------------------
# Demo date as YYYY-MM-DD. Unset: today in Asia/Amman.
# RS_DEMO_DATE=
RS_TAX_BP=0
RS_RESERVATION_TTL_MIN=30
RS_AUTH_EXPIRY_MARGIN_MIN=10
RS_RECONCILE_INTERVAL_MS=15000
RS_RETENTION_INTERVAL_MS=3600000
RS_IMAGE_RETENTION_DAYS=7
RS_UNKNOWN_ESCALATE_MIN=15
RS_PENDING_ESCALATE_MIN=1440

# --- Payments ---------------------------------------------------------------
# fake (simulated, the default) or paypal-sandbox (PayPal Sandbox, no real money)
RS_PAYMENT_PROVIDER=fake
# Only this host is accepted. A loopback stub needs RS_TEST_OFFLINE=1.
RS_PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
RS_PAYPAL_TIMEOUT_MS=20000
# Must be at least 3 times RS_PAYPAL_TIMEOUT_MS.
RS_SAGA_LEASE_MS=60000
# Fake approval page listener (loopback only outside test mode). Port 0 picks a free port.
RS_FAKE_APPROVAL_HOST=127.0.0.1
RS_FAKE_APPROVAL_PORT=0
# At least 32 bytes. Unset: a random key is generated once and kept in the database.
# RS_FAKE_WEBHOOK_SECRET=<placeholder>

# PayPal Sandbox credentials, one set per supplier A to E, or one DEFAULT set
# for all suppliers (single-credential mode). Client id and client secret must
# be set together. Sandbox apps only; never live credentials. Provide the real
# values as environment secrets or through a hidden prompt (see
# docs/runbooks/live-paypal.md), never in chat, in a commit or on a command line.
# RS_PAYPAL_A_CLIENT_ID=<placeholder>
# RS_PAYPAL_A_CLIENT_SECRET=<placeholder>
# RS_PAYPAL_A_WEBHOOK_ID=<placeholder>
# RS_PAYPAL_B_CLIENT_ID=<placeholder>
# RS_PAYPAL_B_CLIENT_SECRET=<placeholder>
# RS_PAYPAL_B_WEBHOOK_ID=<placeholder>
# RS_PAYPAL_C_CLIENT_ID=<placeholder>
# RS_PAYPAL_C_CLIENT_SECRET=<placeholder>
# RS_PAYPAL_C_WEBHOOK_ID=<placeholder>
# RS_PAYPAL_D_CLIENT_ID=<placeholder>
# RS_PAYPAL_D_CLIENT_SECRET=<placeholder>
# RS_PAYPAL_D_WEBHOOK_ID=<placeholder>
# RS_PAYPAL_E_CLIENT_ID=<placeholder>
# RS_PAYPAL_E_CLIENT_SECRET=<placeholder>
# RS_PAYPAL_E_WEBHOOK_ID=<placeholder>
# RS_PAYPAL_DEFAULT_CLIENT_ID=<placeholder>
# RS_PAYPAL_DEFAULT_CLIENT_SECRET=<placeholder>
# RS_PAYPAL_DEFAULT_WEBHOOK_ID=<placeholder>

# --- Request extraction (model) ---------------------------------------------
# cli (the local claude binary), fake (simulated, labelled) or anthropic
RS_MODEL_PROVIDER=cli
RS_MODEL=haiku
# 1 to 40000. The browser gives up on an extraction after 45 s, so a longer
# server timeout would hold the customer's single model slot for nothing.
RS_MODEL_TIMEOUT_MS=30000
RS_MODEL_CALL_CAP_USD=0.05
RS_MODEL_DAILY_BUDGET_USD=1.00
# 0 to 1; 1 turns the per-customer share off
RS_MODEL_CUSTOMER_DAILY_SHARE=0.2
RS_FAKE_MODEL_COST_USD=0
# Reserved. Parsed, but it has no effect in version one: opt-in rephrasing of
# explanations is built and unit-tested, but no route calls it. Leave at 0.
RS_EXPLAIN_REPHRASE=0
# Direct API provider (RS_MODEL_PROVIDER=anthropic). Only this host is accepted.
# ANTHROPIC_API_KEY=<placeholder>
RS_ANTHROPIC_MODEL=claude-haiku-4-5-20251001
RS_ANTHROPIC_BASE_URL=https://api.anthropic.com
# Prices per million tokens; verify against the current price list.
RS_ANTHROPIC_USD_PER_MTOK_IN=1.00
RS_ANTHROPIC_USD_PER_MTOK_OUT=5.00

# --- Accounts and abuse limits ----------------------------------------------
# At least 16 characters.
# RS_ADMIN_PASSWORD=<placeholder>
# At least 12 characters. Set: all seven demo accounts share it. Unset: the
# seed prints a random password per account, once.
# RS_DEMO_PASSWORD=<placeholder>
# Use 0 for a publicly reachable demo.
RS_ALLOW_SIGNUP=1
RS_MAX_LIVE_RESERVATIONS_PER_CUSTOMER=1
RS_MAX_REQUESTS_PER_CUSTOMER_PER_DAY=10
# Registrations per client address per hour (at most 5 outside test mode).
RS_REGISTER_PER_IP_PER_HOUR=5
# Planning requests per customer per window (limit 1 to 1000, window 1 to 1440 minutes).
RS_PLAN_RATE_LIMIT=10
RS_PLAN_RATE_WINDOW_MIN=10
# General limit: requests per signed-in user per window (limit 1 to 100000, window 1 to 3600 seconds).
# Above it the answer is 429 RATE_LIMITED with Retry-After.
RS_GENERAL_RATE_LIMIT=300
RS_GENERAL_RATE_WINDOW_SEC=60

# --- Test-only (leave as is for normal use) ---------------------------------
# Older Node binaries for the start-old-node test (comma separated).
RS_OLD_NODE_BINS=
# Test-only fault injection. Refused when RS_PAYMENT_PROVIDER=paypal-sandbox.
RS_TEST_HOOKS=0
# Set by the test harness: forces the fake model, allows loopback base URLs,
# shows the Test mode banner.
RS_TEST_OFFLINE=0
# Opt-in live suites. Unset: off. The model suite is billed to your account and
# the PayPal suite contacts the PayPal Sandbox. Neither is part of npm test.
# Runbooks: docs/runbooks/live-model.md and docs/runbooks/live-paypal.md.
# RS_LIVE_MODEL=
# RS_LIVE_PAYPAL=
#
# Variables read only by the live suites and the webhook route, not by
# src/config.js. They are described in prose here, not as NAME=value lines,
# because test/scan/env-example.test.js checks every NAME=value line against the
# spec's table of defaults. Set them in the shell for one run, never in a
# file that is committed.
#   RS_LIVE_MODEL_CEILING_USD      The most you are willing to spend on one live model
#                                  run (npm run test:live-model); required together
#                                  with RS_LIVE_MODEL=1; an exact decimal from 0.01 to
#                                  5.00 with at most two decimals (for example 0.50
#                                  or 5); anything else, including 5.0000001, 1e0 or
#                                  05, is refused with exit 2.
#   RS_LIVE_PAYPAL_HEADED          Set to 1 to open a visible Chromium for the
#                                  RS-31(b) Sandbox journey, where a person approves
#                                  at PayPal Sandbox. Without it that check is
#                                  reported as skipped, never as passed.
#   RS_LIVE_PAYPAL_WEBHOOK_SAMPLE  Path of a JSON file with one genuine signed
#                                  Sandbox webhook delivery, for the RS-23 live
#                                  check. Without it that check is reported as
#                                  skipped.
#   RS_PAYPAL_WEBHOOK_ALGOS        Comma-separated allow-list of paypal-auth-algo
#                                  values the webhook route accepts. Unset:
#                                  SHA256withRSA only. A malformed list falls back
#                                  to that default.
