# Groundwork configuration. Every variable is optional; the value shown is the default
# (from src/config.js, also listed in README.md under Configuration).
# There is no .env loader: export these in your shell or service definition.
# Do not commit a real .env; it is git-ignored.

# Listen port (0 = ephemeral).
PORT=3000

# Bind address. Loopback by default; do not expose without TLS in front.
HOST=127.0.0.1

# SQLite file. The parent directory is created if missing.
GW_DB_PATH=./data/groundwork.db

# Set 1 to add Secure to cookies when served over HTTPS.
GW_COOKIE_SECURE=0

# json (structured request logs with request ids) or off.
GW_LOG=json

# 1 enables the fake providers (fake, fake-clean) for tests and demos. Leave off elsewhere.
GW_ENABLE_FAKE=0

# Model alias passed to `claude -p`. Keep it small.
GW_CLI_MODEL=haiku

# Per-call spend cap in USD for the CLI provider.
GW_CLI_MAX_BUDGET_USD=0.10

# Per-call timeout in milliseconds for the CLI provider.
GW_CLI_TIMEOUT_MS=90000

# Path to the Claude Code binary.
GW_CLAUDE_BIN=claude

# Comma-separated names of extra environment variables passed through to the CLI child process.
GW_CLI_ENV_PASS=

# Enables the Anthropic API provider. Secret: never commit a real value.
ANTHROPIC_API_KEY=

# Model for the Anthropic provider.
GW_ANTHROPIC_MODEL=claude-haiku-5-5

# Must be https; plain http is accepted only for loopback (local fake in tests).
GW_ANTHROPIC_URL=https://api.anthropic.com

# Password for seeded users, 10 to 128 characters. Empty = the demo password.
GW_SEED_PASSWORD=
