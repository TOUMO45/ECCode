{
  "name": "groundwork",
  "version": "1.0.0",
  "description": "Incident postmortems the AI cannot make up",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.5" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.js",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/unit/**/*.test.js\" \"test/api/**/*.test.js\" \"test/eval/**/*.test.js\"",
    "test:browser": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 test/browser/journey.test.js",
    "test:live": "GW_LIVE=1 node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"test/live/**/*.test.js\"",
    "eval": "node --disable-warning=ExperimentalWarning eval/run.js"
  }
}
