      "reason": "created",
      "content": {
        "title": "HTTP calls to LLM APIs need node-fetch/axios because global fetch is missing",
        "kind": "limitation",
        "summary": "On Node.js versions before 18 there is no global fetch; code calling LLM HTTP APIs with fetch() throws ReferenceError: fetch is not defined. Use node-fetch or axios as an HTTP client.",
        "details": "Seeded by the orchestrator as prior knowledge from an older project to exercise applicability checks. Node.js 18 made an experimental global fetch available by default.",
        "environment": {
          "node": "<18"
        },
        "tradeoffs": "Adds a runtime dependency that is unnecessary on modern Node.",
        "sources": [
          {
            "title": "Node.js 18 release announcement (global fetch available by default)",
            "url": "https://nodejs.org/en/blog/announcements/v18-release-announce",
            "checkedAt": "2026-10-07"
          }
        ],
        "appliesWhen": [
          "Runtime is Node.js older than 18"
        ],
        "notApplicableWhen": [
          "env:node >=18"
        ],
        "confidence": "high",
        "tags": [
          "fetch",
          "http client",
          "llm api",
          "node"
        ]
      }
    }
  ],
