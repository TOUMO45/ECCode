# inline ECCODE_TEST=1  [main]  want: deny
  $ ECCODE_TEST=1 eccode gate reopen design --actor user --resolution ok
  old        : deny: The guard cannot verify who this eccode command acts as: ECCODE_ACTOR / ECCODE_TEST / ECCO
  new        : deny: The guard cannot verify who this eccode command acts as: ECCODE_ACTOR / ECCODE_TEST / ECCO
  new/win32  : deny: The guard cannot verify who this eccode command acts as: ECCODE_ACTOR / ECCODE_TEST / ECCO

# inline ECCODE_TEST=1 with override  [main]  want: deny
  $ ECCODE_TEST=1 ECCODE_GUARD_PLATFORM=linux eccode gate start design --actor orchestrator
  old        : deny: The guard cannot verify who this eccode command acts as: ECCODE_ACTOR / ECCODE_TEST / ECCO
  new        : deny: The guard cannot verify who this eccode command acts as: ECCODE_ACTOR / ECCODE_TEST / ECCO
  new/win32  : deny: The guard cannot verify who this eccode command acts as: ECCODE_ACTOR / ECCODE_TEST / ECCO

