
# win path memory write (CI 133 shape)  [main]  want: deny
  $ echo "{}" > C:\Users\me\.eccode\memory\records\mem-sd-x.json
  old        : allow
  new        : deny: ECCode project record files are written only by the eccode CLI. Use eccode commands; never
  new/win32  : deny: ECCode project record files are written only by the eccode CLI. Use eccode commands; never

# win path memory write, reviewer  [technical-reviewer]  want: deny
  $ echo "{}" > C:\Users\me\.eccode\memory\records\mem-sd-x.json
