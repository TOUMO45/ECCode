-module.exports = { startGate, submit, recordReview, reopenGate, checkReview, gateAuthors, predecessor, archiveReview, ORCHESTRATOR, USER };
+/**
+ * A review prefilled from the record, so that no reviewer writes the JSON from memory: the criteria are the
+ * acceptance criteria of the tasks under review, each citing the checks this reviewer ran and saw pass after the
+ * submission. With a summary it is a complete approval; without one it is a draft to edit (for example into a
+ * changes_requested review). recordReview still applies every rule to it.
+ */
+function draftReview(store, gateId, reviewer, { summary } = {}) {
+  const state = store.state();
+  const g = state.gates[gateId];
+  if (!g) throw new EccodeError('UNKNOWN_GATE', `Unknown gate ${gateId}. Gates: ${state.gateOrder.join(', ')}`);
+  const sub = (g.submissions || [])[g.submissions.length - 1];
+  if (g.status !== 'submitted' || !sub) {
+    throw new EccodeError('INVALID_TRANSITION', `Gate ${gateId} is ${g.status}: only a submitted gate can be reviewed. Run eccode status --brief and do what NEXT says.`);
+  }
+  const scope = gateKind(gateId) === 'phase' ? phaseTasks(state, gateId) : Object.values(state.tasks);
+  const mine = Object.values(state.evidence)
+    .filter((e) => e.kind === 'command' && e.recordedBy === reviewer && e.status === 'passed' && e.at >= sub.at)
+    .map((e) => `ev:${e.id}`);
+  const wanted = [...new Set(scope.flatMap((t) => t.acceptanceCriteria || []))];
+  const criteria = (wanted.length ? wanted : ['the submitted work does what was asked and its checks pass'])
+    .map((description, i) => ({ id: `C${i + 1}`, description, met: true, evidence: mine }));
+  return {
+    decision: 'approve',
+    summary: summary || 'TODO: the verdict in one or two sentences, grounded in the checks you ran',
+    criteria,
+    findings: [],
+    // After a rejection, an approval must say each earlier finding is resolved, on the reviewer's fresh evidence.
+    resolvedFindings: (g.openFindings || []).map((f) => ({ id: f.id, resolution: `Addressed in ${sub.id}; checked again after the resubmission.`, evidence: mine })),
+    lessonsConsulted: [],
+  };
+}
+
+module.exports = { draftReview, startGate, submit, recordReview, reopenGate, checkReview, gateAuthors, predecessor, archiveReview, ORCHESTRATOR, USER };
