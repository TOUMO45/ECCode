{
  "$id": "eccode/gf-prd",
  "title": "Product requirements",
  "description": "Shape only; the semantic checks (coverage, criteria kinds, ambiguity scan) are rules GF-PRD-1..3 in lib/greenfield/stages/prd.js.",
  "type": "object",
  "required": [
    "problem",
    "users",
    "scope",
    "nonGoals",
    "ambiguityScan",
    "criteria"
  ],
  "additionalProperties": false,
  "properties": {
    "problem": {
      "type": "string",
      "minLength": 80
    },
    "users": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "goals"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 5
          },
          "goals": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 3
            },
            "minItems": 1
          }
        }
      },
      "minItems": 1
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S-[A-Z0-9-]+$"
          },
          "statement": {
            "type": "string",
            "minLength": 5
          }
        }
      },
      "minItems": 1
    },
    "nonGoals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      },
      "minItems": 1
    },
    "ambiguityScan": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "none",
            "justification"
          ],
          "additionalProperties": false,
          "properties": {
            "none": {
              "const": true
            },
            "justification": {
              "type": "string",
              "minLength": 20
            }
          }
        },
        {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "question",
              "resolution"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "question": {
                "type": "string",
                "minLength": 5
              },
              "resolution": {
                "enum": [
                  "clarified",
                  "assumed"
                ]
              },
              "assumptionId": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "minItems": 1
        }
      ]
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "covers",
          "priority"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC-[0-9]+$"
          },
          "statement": {
            "type": "string",
            "minLength": 10
          },
          "covers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "verify": {
            "type": "object"
          }
        }
      },
      "minItems": 1
    }
  }
}
