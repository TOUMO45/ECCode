{
  "$id": "eccode/memory-debugging",
  "title": "Debugging lesson",
  "description": "A bug investigation. Becomes 'verified' only after an independent review confirms a reproduction (failing check), a verified fix (passing check), root-cause evidence and explicit applicability conditions.",
  "type": "object",
  "required": ["title", "problem", "symptoms", "component", "environment", "reproduction", "rootCause", "failedAttempts", "solution", "verification", "sources", "appliesWhen", "notApplicableWhen", "confidence"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "minLength": 8 },
    "problem": { "type": "string", "minLength": 15 },
    "symptoms": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
    "component": { "type": "string", "minLength": 2 },
    "environment": { "type": "object" },
    "fingerprint": { "type": "string", "description": "Stable signature of the failure (e.g. error code + component) used to detect recurrence." },
    "occurredAt": { "type": "string" },
    "reproduction": {
      "type": "object",
      "properties": {
        "steps": { "type": "array", "items": { "type": "string" } },
        "evidence": { "type": "array", "items": { "type": "string", "pattern": "^ev:" } },
        "unavailable": { "type": "string", "description": "Why reproduction was not possible; keeps the lesson provisional." }
      }
    },
    "rootCause": {
      "type": "object",
      "required": ["explanation", "evidence"],
      "properties": {
        "explanation": { "type": "string", "minLength": 15 },
        "evidence": { "type": "array", "items": { "type": "string" } }
      }
    },
    "failedAttempts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["approach", "whyFailed"],
        "properties": { "approach": { "type": "string", "minLength": 5 }, "whyFailed": { "type": "string", "minLength": 5 } }
      }
    },
    "solution": {
      "type": "object",
      "required": ["description", "tradeoffs"],
      "properties": { "description": { "type": "string", "minLength": 10 }, "tradeoffs": { "type": "string", "minLength": 3 } }
    },
    "verification": {
      "type": "object",
      "required": ["evidence"],
      "properties": {
        "evidence": { "type": "array", "items": { "type": "string", "pattern": "^ev:" } },
        "regressionTest": { "type": "string" },
        "unavailable": { "type": "string" }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "checkedAt"],
        "properties": { "title": { "type": "string" }, "url": { "type": "string" }, "checkedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" } }
      }
    },
    "appliesWhen": { "type": "array", "items": { "type": "string", "minLength": 3 } },
    "notApplicableWhen": { "type": "array", "items": { "type": "string", "minLength": 3 } },
    "confidence": { "enum": ["low", "medium", "high"] },
    "tags": { "type": "array", "items": { "type": "string" } }
  }
}
