{
  "$id": "eccode/plan",
  "title": "Phased delivery plan",
  "type": "object",
  "required": ["phases", "tasks"],
  "additionalProperties": false,
  "properties": {
    "lessonDecisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "decision", "note"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "decision": { "enum": ["incorporated", "not-applicable"] },
          "note": { "type": "string" }
        }
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "goal", "acceptanceCriteria"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 3 },
          "goal": { "type": "string", "minLength": 10 },
          "acceptanceCriteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "phase", "title", "owner", "dependencies", "inputs", "outputs", "files", "acceptanceCriteria", "verification"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
          "phase": { "type": "string" },
          "title": { "type": "string", "minLength": 5 },
          "owner": { "type": "string", "minLength": 2 },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "inputs": { "type": "array", "items": { "type": "string" } },
          "outputs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "components": { "type": "array", "items": { "type": "string" } },
          "files": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "acceptanceCriteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
          "verification": {
            "type": "object",
            "required": ["method"],
            "additionalProperties": false,
            "properties": {
              "method": { "type": "string", "minLength": 5 },
              "command": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
