{
  "$id": "eccode/memory-knowledge",
  "title": "Engineering knowledge",
  "description": "A researched technique, pattern, limitation or tradeoff, with dated sources.",
  "type": "object",
  "required": ["title", "summary", "sources", "appliesWhen", "notApplicableWhen", "confidence"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "minLength": 8 },
    "summary": { "type": "string", "minLength": 20 },
    "details": { "type": "string" },
    "kind": { "enum": ["technique", "pattern", "limitation", "tradeoff"] },
    "environment": { "type": "object" },
    "tradeoffs": { "type": "string" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "checkedAt"],
        "properties": { "title": { "type": "string" }, "url": { "type": "string" }, "checkedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" } }
      }
    },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "appliesWhen": { "type": "array", "items": { "type": "string" } },
    "notApplicableWhen": { "type": "array", "items": { "type": "string" } },
    "confidence": { "enum": ["low", "medium", "high"] },
    "tags": { "type": "array", "items": { "type": "string" } }
  }
}
